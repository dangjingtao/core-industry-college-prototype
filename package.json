{
  "name": "core-industry-college-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:pc": "npm run dev --workspace @core/pc",
    "dev:mobile": "npm run dev --workspace @core/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:pc": "npm run build --workspace @core/pc",
    "build:mobile": "npm run build --workspace @core/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}

